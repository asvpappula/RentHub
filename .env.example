# Copy to .env.local and fill in real values. See supabase/README.md.

NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxx
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx

# Owner payouts via Stripe Connect. Leave "false" until you have (1) enabled
# Connect in the Stripe dashboard and (2) tested onboarding + a transfer.
# When "false", the app collects renter payments normally but does NOT create
# owner transfers (funds stay on the platform) and shows an honest
# "payouts launching soon" state. Set to "true" to turn on the full flow.
STRIPE_CONNECT_ENABLED=false

NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional — phone verification SMS (twilio.com). Without these, phone
# verification runs in dev mode (code shown on screen instead of SMS).
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
